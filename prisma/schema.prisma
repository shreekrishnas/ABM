// ABM Intelligence Platform — database schema.
// The built-in CRM is the system of record: accounts, contacts, opportunities,
// tasks, notes. Pipeline state, evidence and engagement hang off those records.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Enums ─────────────────────────────

enum FieldStatus {
  verified
  probable
  conflicting
  stale
  invalid
  unknown
}

enum Relationship {
  prospect
  customer
  competitor
  partner
}

enum Tier {
  T1
  T2
  T3
}

enum BuyingStage {
  UNAWARE
  AWARE
  ENGAGED
  MQA
  OPPORTUNITY
  CUSTOMER
  WATCH
  DISQUALIFIED
  RECYCLED
}

enum Priority {
  high
  medium
  low
}

enum BuyingRole {
  decision_maker
  champion
  influencer
  budget_owner
  unknown
}

enum ContactState {
  new
  selected
  ready
  in_sequence
  paused
  replied
  handed_off
  suppressed
  do_not_contact
}

enum ReadinessOutcome {
  ready
  targeted_re_research
  watch
  human_review
  disqualified
}

enum DraftStatus {
  pending_review
  approved
  rejected
  blocked
  sent
}

enum MessageStatus {
  queued
  delivered
  bounced
  duplicate_skipped
  failed
}

enum ReplyClass {
  positive
  objection
  not_now
  unsubscribe
  wrong_person
  out_of_office
  needs_human
}

enum Channel {
  email
  linkedin
  call
  task
}

enum EnrollmentStatus {
  active
  paused
  completed
  stopped
}

enum SignalType {
  email_open
  email_click
  email_reply
  site_visit
  pricing_visit
  intent_surge
  job_change
  event_attended
  content_download
}

enum ReviewType {
  identity_conflict
  contradiction
  draft_approval
  guardrail_failed
  budget_exceeded
  no_usable_person
  lawful_basis_missing
  briefing_blocked
  needs_human_reply
  bounce_breaker
  other
}

enum ReviewStatus {
  open
  resolved
  dismissed
}

enum WatchStatus {
  waiting
  due
  processed
  cancelled
}

enum OppStage {
  discovery
  qualification
  proposal
  negotiation
  won
  lost
}

enum TaskStatus {
  todo
  in_progress
  done
  cancelled
}

enum EventOutcome {
  pass
  block
  info
  error
}

enum LedgerKind {
  llm
  lookup
  verification
  search
}

enum UserRole {
  admin
  marketer
  rep
  reviewer
}

// ───────────────────────────── CRM core ─────────────────────────────

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole @default(rep)
  createdAt DateTime @default(now())

  ownedAccounts Account[]     @relation("AccountOwner")
  opportunities Opportunity[]
  tasks         Task[]        @relation("TaskAssignee")
  notes         Note[]
  handoffs      Handoff[]
}

model Account {
  id            String       @id @default(cuid())
  /// The seller this account is researched and contacted for (a seller pack id). A run never mixes sellers.
  sellerId      String       @default("manch")
  /// Latest multi-signal intent reading: score, level, converging families, signals with evidence, why now.
  intentReading Json?
  name          String
  domain        String?      @unique
  industry      String?
  employees     Int?
  country       String? // ISO-3166 alpha-2
  revenueUsd    BigInt?
  technologies  String[]     @default([])
  /// Company LinkedIn page (normalized) — second matching key after domain.
  linkedinUrl   String?
  /// Normalized name (legal suffixes and punctuation removed) — third matching key.
  nameKey       String?
  city          String?
  /// Products, capabilities, markets (import column "Keywords", ; separated).
  keywords      String[]     @default([])
  /// Import column "Company Notes" (team notes live in Note).
  companyNotes  String?
  relationship  Relationship @default(prospect)
  doNotContact  Boolean      @default(false)
  source        String       @default("manual")

  tier             Tier?
  /// true when a person set the tier by hand; otherwise it follows the fit score.
  tierLocked       Boolean     @default(false)
  stage            BuyingStage @default(UNAWARE)
  fitScore         Int?
  /// Plain-language reasons behind fitScore, one per component (seller-aware).
  fitReasons       String[]    @default([])
  /// The seller use case to lead with (e.g. distributor_onboarding).
  useCase          String?
  dataConfidence   Float?
  researchPriority Priority?
  intentScore      Float       @default(0)
  engagementScore  Float       @default(0)
  scoredAt         DateTime?

  // Pipeline cursor: last completed stage (0 = nothing yet) and loop counters.
  pipelineStage     Int       @default(0)
  pipelineStatus    String    @default("idle") // idle | running | blocked | done | error
  followupUsed      Boolean   @default(false)
  reopenUsed        Boolean   @default(false)
  disqualifyReason  String?
  lastRunAt         DateTime?
  // Set by imports: the account changed and waits for an automatic pipeline run.
  queuedFromStage   Int?
  lastImportBatchId String?

  ownerId      String?
  owner        User?    @relation("AccountOwner", fields: [ownerId], references: [id])
  mergedIntoId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  contacts      Contact[]
  fieldStates   FieldState[]
  evidence      Evidence[]
  twins         TwinVersion[]
  plans         ResearchPlan[]
  signals       Signal[]
  opportunities Opportunity[]
  tasks         Task[]
  notes         Note[]
  events        PipelineEvent[]
  reviewItems   ReviewItem[]
  watchlist     WatchlistEntry[]
  ledger        LedgerEntry[]
  handoffs      Handoff[]
  searches      ResearchQuery[]
  briefs        AccountBrief[]

  @@index([stage])
  @@index([tier])
  @@index([linkedinUrl])
  @@index([nameKey])
  @@index([ownerId])
  @@index([mergedIntoId])
  @@index([pipelineStatus])
}

model Contact {
  id                 String            @id @default(cuid())
  accountId          String
  account            Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  firstName          String?
  lastName           String?
  fullName           String
  email              String?
  phone              String?
  linkedinUrl        String?
  title              String?
  titleNormalized    String?
  function           String? // data, finance, security, engineering, marketing, sales, operations, it, hr, executive
  /// As given in the import (the inferred function above is used for buying roles).
  department         String?
  location           String?
  /// Import column "Notes" (team notes live in Note).
  personNotes        String?
  seniority          String? // c_level, vp, director, manager, ic
  buyingRole         BuyingRole        @default(unknown)
  identityConfidence Float?
  state              ContactState      @default(new)
  readiness          ReadinessOutcome?
  readinessReasons   String[]          @default([])
  lawfulBasis        String?
  country            String?
  source             String            @default("manual")
  mergedIntoId       String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  fieldStates FieldState[]
  drafts      Draft[]
  messages    Message[]
  replies     Reply[]
  signals     Signal[]
  enrollments Enrollment[]
  tasks       Task[]
  notes       Note[]
  reviewItems ReviewItem[]
  journeys    Journey[]

  @@index([accountId])
  @@index([email])
  @@index([linkedinUrl])
  @@index([state])
}

model Opportunity {
  id               String    @id @default(cuid())
  accountId        String
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name             String
  amountUsd        Int       @default(0)
  stage            OppStage  @default(discovery)
  source           String    @default("abm") // abm | inbound | outbound | partner
  closeDate        DateTime?
  closedAt         DateTime?
  lostReason       String?
  factTypesAtClose String[]  @default([])
  ownerId          String?
  owner            User?     @relation(fields: [ownerId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([accountId])
  @@index([stage])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  body        String?
  channel     Channel    @default(task)
  status      TaskStatus @default(todo)
  dueAt       DateTime?
  accountId   String?
  account     Account?   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assigneeId  String?
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  origin      String     @default("manual") // manual | sequence | reply | handoff
  createdAt   DateTime   @default(now())
  completedAt DateTime?

  @@index([status, dueAt])
  @@index([accountId])
}

model Note {
  id        String   @id @default(cuid())
  body      String
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

// ───────────────────────────── Verification & evidence ─────────────────────────────

/// Status of one field on an account or contact (title, email, industry ...).
model FieldState {
  id          String      @id @default(cuid())
  accountId   String?
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  field       String
  value       String?
  status      FieldStatus @default(unknown)
  source      String?
  observedAt  DateTime? // when the source says the value was true
  checkedAt   DateTime    @default(now())
  recheckUsed Boolean     @default(false)

  @@unique([accountId, field])
  @@unique([contactId, field])
}

model Evidence {
  id                String      @id @default(cuid())
  accountId         String
  account           Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  key               String // question key: trigger, owner_function, negative, tooling, size ...
  claim             String // human-readable fact
  value             String? // normalized value for contradiction checks
  sourceUrl         String
  sourceType        String // official | press | news | careers | provider | review_site | mock
  publishedAt       DateTime
  isNegative        Boolean     @default(false)
  negativeKind      String? // layoffs | hiring_freeze | acquired | bankrupt | competitor_signed
  status            FieldStatus @default(probable)
  supersededById    String?
  pass              String      @default("main") // main | followup | reopen | refresh
  /// Search engine that found the source (exa | tavily | serp | mock).
  engine            String?
  /// A person marked this fact as wrong. Feeds fact-precision on the AI Brain page.
  flagged           Boolean     @default(false)
  flagReason        String?
  /// Exact supporting sentence copied from the source page (checked by code to appear on the page).
  quote             String?
  sellerId          String?
  sellerPackVersion String?
  createdAt         DateTime    @default(now())

  @@index([accountId, key])
}

model TwinVersion {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  version   Int
  /// { facts[], inferences[], contradictions[], negatives[], changed[], unknowns[] }
  snapshot  Json
  createdAt DateTime @default(now())

  @@unique([accountId, version])
}

/// Every web search the brain ran (or served from cache). Drives the search cache,
/// engine routing and the research-efficiency numbers on the AI Brain page.
model ResearchQuery {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  key        String
  engine     String // exa | tavily | serp | mock | auto
  query      String
  queryHash  String
  pass       String
  purpose    String?
  results    Int      @default(0)
  kept       Int      @default(0)
  cached     Boolean  @default(false)
  costMicros Int      @default(0)
  /// Pages returned, kept for the cache window so re-runs don't spend credits again.
  pages      Json?
  error      String?
  createdAt  DateTime @default(now())

  @@index([accountId, key, queryHash])
  @@index([engine, key])
  @@index([createdAt])
}

/// The brain's synthesis of an account: pain points tied to evidence, persona angles,
/// hypotheses for discovery, risks and the next best action.
model AccountBrief {
  id                String   @id @default(cuid())
  accountId         String
  account           Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  version           Int
  brief             Json
  model             String
  sellerId          String?
  sellerPackVersion String?
  createdAt         DateTime @default(now())

  @@unique([accountId, version])
}

/// What is working and what is not, summarised from outcomes.
model BrainInsight {
  id        String   @id @default(cuid())
  stats     Json
  summary   Json
  model     String
  createdAt DateTime @default(now())
}

model ResearchPlan {
  id         String   @id @default(cuid())
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  questions  Json // [{ key, question, importance, query?, engine?, why? }]
  skipped    Json // [{ key, reason }]
  reason     String // initial | refresh | intent_surge
  /// The brain's hypotheses about this company, tested by the research.
  hypotheses String[] @default([])
  /// "mock" or the LLM model that planned the research.
  planner    String?
  /// core | deep, and why ("T1", "engaged on LinkedIn: Asha Mehta — Interested").
  depth      String?
  createdAt  DateTime @default(now())

  @@index([accountId])
}

// ───────────────────────────── Engagement ─────────────────────────────

model Signal {
  id         String     @id @default(cuid())
  accountId  String
  account    Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  type       SignalType
  points     Float
  /// true when the person was contacted by us (counts toward person-level handoff).
  attributed Boolean    @default(false)
  anonymous  Boolean    @default(false)
  source     String // tracking | intent_provider | email_provider | crm | manual
  detail     String?
  occurredAt DateTime   @default(now())

  @@index([accountId, occurredAt])
}

model Sequence {
  id        String   @id @default(cuid())
  name      String
  tier      Tier?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  steps       SequenceStep[]
  enrollments Enrollment[]
}

model SequenceStep {
  id          String   @id @default(cuid())
  sequenceId  String
  sequence    Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  order       Int
  channel     Channel
  dayOffset   Int
  instruction String // what the step should do (angle / follow-up type)

  @@unique([sequenceId, order])
}

model Enrollment {
  id           String           @id @default(cuid())
  contactId    String
  contact      Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  sequenceId   String
  sequence     Sequence         @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  currentStep  Int              @default(1)
  status       EnrollmentStatus @default(active)
  nextDueAt    DateTime?
  pausedReason String?
  createdAt    DateTime         @default(now())

  @@unique([contactId, sequenceId])
  @@index([status, nextDueAt])
}

model Draft {
  id                String      @id @default(cuid())
  contactId         String
  contact           Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  stepOrder         Int         @default(1)
  subject           String
  body              String
  angle             String? // trigger key used as the lead
  /// Brain angle for this person: pain point + capability (differs per colleague).
  painPoint         String?
  useCase           String?
  /// Second check: is every claim supported by the cited fact? [{ text, supported, reason }]
  claimCheck        Json?
  /// [{ text, factIds[] }]
  claims            Json
  leadEvidenceId    String?
  status            DraftStatus @default(pending_review)
  guardrailAttempts Int         @default(0)
  blockReason       String?
  reviewerNote      String?
  reviewedAt        DateTime?
  /// Critic panel verdicts on the final version: [{ critic, pass, issues[] }]
  critique          Json?
  /// Writing knowledge used: { play, persona, examples[], marketFacts[] } — so replies can be traced to it.
  knowledge         Json?
  /// How many times the rewriter revised this draft after critique.
  rewrites          Int         @default(0)
  sellerId          String?
  sellerPackVersion String?
  createdAt         DateTime    @default(now())

  message Message?

  @@index([status])
}

model Message {
  id         String        @id @default(cuid())
  draftId    String        @unique // idempotency key: a draft is sent at most once
  draft      Draft         @relation(fields: [draftId], references: [id], onDelete: Cascade)
  contactId  String
  contact    Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  mailbox    String
  status     MessageStatus @default(queued)
  providerId String?
  sentAt     DateTime?
  bouncedAt  DateTime?
  bounceType String? // hard | soft

  replies Reply[]

  @@index([sentAt])
}

model Reply {
  id         String     @id @default(cuid())
  messageId  String?
  message    Message?   @relation(fields: [messageId], references: [id], onDelete: SetNull)
  contactId  String
  contact    Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  body       String
  class      ReplyClass
  route      String
  receivedAt DateTime   @default(now())
}

model Suppression {
  id        String   @id @default(cuid())
  /// lowercase email, `@domain`, or `sha256:<hash>` for erased people
  value     String   @unique
  reason    String // unsubscribe | hard_bounce | erasure | manual | complaint
  createdAt DateTime @default(now())
}

// ───────────────────────────── Operations ─────────────────────────────

model PipelineEvent {
  id        String       @id @default(cuid())
  accountId String?
  account   Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId String?
  stage     Int
  step      String // e.g. "fit_tier.exclusions"
  outcome   EventOutcome
  reason    String?
  data      Json?
  runId     String?
  createdAt DateTime     @default(now())

  @@index([accountId, createdAt])
  @@index([stage, outcome])
  @@index([runId])
}

model ReviewItem {
  id         String       @id @default(cuid())
  type       ReviewType
  status     ReviewStatus @default(open)
  reason     String
  stage      Int
  accountId  String?
  account    Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  draftId    String?
  payload    Json?
  dueAt      DateTime?
  resolution String?
  resolvedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([status, type])
}

model WatchlistEntry {
  id        String      @id @default(cuid())
  accountId String
  account   Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  reason    String
  recheckAt DateTime
  status    WatchStatus @default(waiting)
  createdAt DateTime    @default(now())

  @@index([status, recheckAt])
}

model LedgerEntry {
  id           String     @id @default(cuid())
  accountId    String
  account      Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind         LedgerKind
  amountMicros Int // millionths of a dollar, avoids float drift
  description  String
  stage        Int
  createdAt    DateTime   @default(now())

  @@index([accountId])
}

model Handoff {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerId        String?
  owner          User?     @relation(fields: [ownerId], references: [id])
  trigger        String // positive_reply | mqa_threshold | manual
  /// { whyNow, facts[{text,factId}], unknowns[], engaged[{name,title,signals}] }
  briefing       Json
  blocked        Boolean   @default(false)
  alertedAt      DateTime?
  ackDueAt       DateTime?
  acknowledgedAt DateTime?
  escalatedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([acknowledgedAt])
}

model Mailbox {
  id        String   @id @default(cuid())
  address   String   @unique
  dailyCap  Int      @default(40)
  active    Boolean  @default(true)
  warmedUp  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ImportBatch {
  id             String         @id @default(cuid())
  filename       String
  source         String // csv | api | form | manual
  status         String         @default("done") // uploading | processing | done | failed
  rows           Int
  accepted       Int
  rejected       Int
  errors         Json // [{ row, error }] (capped)
  /// { accountsCreated, accountsUpdated, accountsUnchanged, contactsCreated, contactsUpdated, contactsUnchanged, skippedErased }
  stats          Json           @default("{}")
  ignoredColumns String[]       @default([])
  /// Import-level selections applied to every valid row.
  campaignId     String?
  campaign       Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  senderId       String?
  sender         SenderProfile? @relation(fields: [senderId], references: [id], onDelete: SetNull)
  /// header → field key, as mapped in the wizard
  mapping        Json?
  toProcess      Int            @default(0)
  processed      Int            @default(0)
  createdAt      DateTime       @default(now())
  finishedAt     DateTime?
}

// ───────────────────────────── People journeys ─────────────────────────────
// A company and a person are stored once. Each sender profile has its own journey
// under the same person (unique per person + campaign + sender), so Sender 1
// activity never overwrites Sender 2 activity.

enum JourneyStage {
  not_contacted
  connection_sent
  connection_accepted
  follow_up_sent
  replied_neutral
  details_requested
  details_shared
  interested
  nurture
  referred
  not_interested
  disqualified
  call_scheduled
  demo_scheduled
  opportunity
  closed_won
  closed_lost
}

model Campaign {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  journeys Journey[]
  imports  ImportBatch[]
}

model SenderProfile {
  id          String   @id @default(cuid())
  name        String   @unique
  linkedinUrl String?
  email       String?
  notes       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  journeys Journey[]
  imports  ImportBatch[]
}

model Journey {
  id               String        @id @default(cuid())
  contactId        String
  contact          Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  campaignId       String
  campaign         Campaign      @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  senderId         String
  sender           SenderProfile @relation(fields: [senderId], references: [id], onDelete: Cascade)
  stage            JourneyStage  @default(not_contacted)
  followUpCount    Int           @default(0)
  /// Every inbound message counts; the meaning sets the stage.
  replyCount       Int           @default(0)
  lastEngagementAt DateTime?
  lastEngagement   String?
  stageReason      String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  events JourneyEvent[]

  @@unique([contactId, campaignId, senderId])
  @@index([campaignId, senderId])
  @@index([stage])
}

model JourneyEvent {
  id         String        @id @default(cuid())
  journeyId  String
  journey    Journey       @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  /// connection_sent | connection_accepted | follow_up_sent | reply | details_shared | call_scheduled | demo_scheduled | call_logged | stage_set | note | imported
  type       String
  fromStage  JourneyStage?
  toStage    JourneyStage?
  detail     String?
  /// csv | manual | bulk | agent | system
  source     String        @default("manual")
  occurredAt DateTime      @default(now())
  createdAt  DateTime      @default(now())

  @@index([journeyId, occurredAt])
}

/// Typed, stored, replayable signals between brain modules. Modules never call each other; they publish here.
model BrainSignal {
  id          String   @id @default(cuid())
  runId       String
  accountId   String?
  sellerId    String
  packVersion String
  /// e.g. seller.context, run.planned, research.done, evidence.judged, brief.ready, readiness.decided, draft.critiqued, draft.ready, verdict.conflict
  type        String
  /// Module that published it.
  module      String
  payload     Json
  createdAt   DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([runId])
  @@index([type, createdAt])
}

/// A judgement with both sides: what was chosen, the case for and against, the evidence for each, and a confidence.
model Decision {
  id              String   @id @default(cuid())
  runId           String?
  accountId       String?
  contactId       String?
  draftId         String?
  module          String
  question        String
  choice          String
  caseFor         String
  caseAgainst     String
  evidenceFor     String[] @default([])
  evidenceAgainst String[] @default([])
  confidence      Float
  /// acted = the brain did it itself; needs_human = it stopped inside a fence and asked.
  autonomy        String
  sellerId        String
  packVersion     String
  createdAt       DateTime @default(now())

  @@index([accountId, createdAt])
  @@index([module, createdAt])
}

/// Self-improver proposals. Never applied automatically: a person accepts, and a test must cover the change.
model Proposal {
  id         String    @id @default(cuid())
  sellerId   String
  /// research | messaging | icp | rules
  area       String
  change     String
  rationale  String
  evidence   String
  sampleSize Int
  /// Below the sample threshold the finding is labelled tentative.
  tentative  Boolean
  /// proposed | accepted | rejected
  status     String    @default("proposed")
  createdAt  DateTime  @default(now())
  decidedAt  DateTime?

  @@index([status, createdAt])
}

/// A buying event found by the market scan for a company that may not be in the database yet.
model MarketEvent {
  id          String   @id @default(cuid())
  sellerId    String
  company     String
  nameKey     String
  industry    String?
  /// Industry bucket used by the trend radar (pharma, fmcg, bfsi…).
  bucket      String
  triggerKey  String
  claim       String
  /// Exact words from the page; the event is kept only if they are on it.
  quote       String
  sourceUrl   String
  publishedAt DateTime
  createdAt   DateTime @default(now())

  @@unique([sellerId, sourceUrl, nameKey])
  @@index([sellerId, bucket, publishedAt])
}

/// A company the brain suggests adding, with the evidence behind it.
model ProspectSuggestion {
  id        String   @id @default(cuid())
  sellerId  String
  name      String
  nameKey   String
  domain    String?
  industry  String?
  bucket    String
  country   String?
  employees Int?
  score     Int
  level     String
  whyNow    String
  families  String[] @default([])
  sources   Json
  /// new | added | dismissed | excluded
  status    String   @default("new")
  reason    String?
  accountId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, nameKey])
  @@index([sellerId, status, score])
}

/// A short-lived lease so only one worker runs a background job at a time (e.g. the
/// import queue drain). A lease past `expiresAt` is free to take over.
model JobLease {
  name       String   @id
  holder     String
  expiresAt  DateTime
  lastRunAt  DateTime?
  /// What the last run did, for the status panel.
  lastResult Json?
  updatedAt  DateTime @updatedAt
}

/// An edited version of a seller pack (Settings → Seller profile → Edit). The newest
/// revision per seller is active; `pack = null` means "back to the built-in pack in code".
/// Restoring an older version saves it again as a new revision, so history is never lost.
model SellerPackRevision {
  id        String   @id @default(cuid())
  sellerId  String
  pack      Json?
  /// Content hash, the same value stamped on facts, briefs and drafts made with this pack.
  version   String
  /// Top-level sections that differ from the previous active pack.
  changed   String[]
  note      String?
  createdAt DateTime @default(now())

  @@index([sellerId, createdAt])
}

/// A document in the knowledge base: built in (sources, playbook, seller pack), uploaded
/// by a person, or learned from messages that got positive replies. Split into chunks.
model KnowledgeDoc {
  id        String           @id @default(cuid())
  sellerId  String
  /// Stable key for built-in and learned docs ("builtin:persona:cio_cdo", "learned:draft:<id>"); null for uploads.
  key       String?
  /// built_in | upload | learned
  origin    String
  /// playbook | persona | objection | example | market_fact | norm | research | case_study | product | competitor | document
  kind      String
  title     String
  text      String
  url       String?
  /// Filters: { channel?, plays?, personas?, useCases?, triggers? }
  tags      Json?
  /// Approved = its claims about the seller may be stated in messages; otherwise background only.
  approved  Boolean          @default(false)
  /// Content hash; unchanged docs are not re-embedded.
  hash      String
  chunks    KnowledgeChunk[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([sellerId, key])
  @@index([sellerId, kind])
}

/// One searchable piece of a document, with its embedding.
model KnowledgeChunk {
  id         String       @id @default(cuid())
  docId      String
  doc        KnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  sellerId   String
  kind       String
  ord        Int
  heading    String?
  text       String
  embedding  Float[]
  /// Model that made the embedding; vectors from different models are never compared.
  embedModel String
  createdAt  DateTime     @default(now())

  @@index([sellerId, embedModel])
  @@index([docId])
}
