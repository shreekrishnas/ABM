DATABASE_URL="postgresql://abm:abm@localhost:5432/abm?schema=public"
# Set to "mock" to force every external service onto mocks (tests, demos).
# Leave empty in production: each service goes live once its key below is set.
ADAPTER_MODE=""
# Web research — any one is enough; more keys = fallback + independent second source
EXA_API_KEY=""
TAVILY_API_KEY=""
SERPAPI_API_KEY=""
# LLM via OpenRouter
OPENROUTER_API_KEY=""
LLM_MODEL="openai/gpt-4o-mini"
# Knowledge base embeddings (same OpenRouter key). Changing it re-embeds the knowledge base.
EMBED_MODEL="openai/text-embedding-3-small"
# Required in production: Authorization: Bearer <key> on /api/v1 (webhooks, REST API).
# Without it every /api/v1 route except /health answers 503 in production.
ABM_API_KEY=""
# Vercel Cron sends this as a bearer token to GET /api/v1/tick. Required for the daily run.
CRON_SECRET=""
# Escape hatch for a private test deployment only: allow /api/v1 with no key in production.
ABM_API_OPEN=""
# "true" stops a company's run when its paid calls reach the tier budget (T1 $5, T2 $2, T3 $0.75).
# Otherwise costs are recorded per company but not capped.
ENFORCE_BUDGETS=""
# Optional: password gate for every page (HTTP Basic auth; any username)
APP_PASSWORD=""
# Set to "true" only to allow POST /api/v1/admin/seed (wipes data!)
ALLOW_SEED=""
# Background queue: this deployment's own URL, if it can't reach itself at the request's
# origin (e.g. password-protected preview deployments).
APP_URL=""
# Background queue slice in ms (default and maximum 45000). Lower only for testing.
QUEUE_SLICE_MS=""
# Website tracking: your website's address(es), comma separated, e.g. https://www.manchtech.com
# Required in production before the tracking script can record visits.
TRACK_ORIGINS=""
# Signs the ?abm= person token added to links to your website (defaults to ABM_API_KEY).
TRACK_SECRET=""
# Apollo.io: contact data (people search, email lookup — 1 credit per lookup) and website visitors.
APOLLO_API_KEY=""
# The Apollo account list your website-visitor companies are saved to (its name); read daily.
# Needs a master API key to look the list up by name; or give its id in APOLLO_VISITOR_LABEL_ID.
APOLLO_VISITOR_LIST=""
APOLLO_VISITOR_LABEL_ID=""
